      "name": "1. Register",
      "description": "Các kịch bản kiểm thử hộp đen cho endpoint POST /api/auth/register",
      "item": [
        {
          "name": "TC-AUTH-01: [Valid] Đăng ký thành công - Email tự động .trim() và .toLowerCase()",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body contains success: true\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"success\");",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"   Test.User@Domain.COM   \",\n  \"password\": \"Password123!\"\n}",
