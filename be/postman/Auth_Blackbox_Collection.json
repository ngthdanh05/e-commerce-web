    {
      "name": "2. Login",
      "description": "Các kịch bản kiểm thử hộp đen cho endpoint POST /api/auth/login",
      "item": [
        {
          "name": "TC-AUTH-07: [Valid Login] Đăng nhập thành công trả về Token & User Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains Token and User Info\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData).to.have.property(\"data\");",
                  "    pm.expect(jsonData.data).to.have.property(\"token\");",
                  "    pm.expect(jsonData.data).to.have.property(\"user\");",
                  "    ",
                  "    // Tự động lưu token vào biến môi trường authToken",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Cookie session_token is set or header Set-Cookie present\", function () {",
                  "    pm.expect(pm.cookies.has(\"session_token\") || pm.response.headers.has(\"Set-Cookie\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"valid@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
