                    "pm.test(\"Verify totalPrice is dynamically and accurately calculated\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    var cartData = jsonData.data || jsonData;",
                    "    ",
                    "    pm.expect(cartData).to.have.property('products');",
                    "    pm.expect(cartData).to.have.property('totalPrice');",
                    "    ",
                    "    var calculatedTotal = 0;",
                    "    if (Array.isArray(cartData.products)) {",
                    "        cartData.products.forEach(function(item) {",
                    "            calculatedTotal += (item.price * item.quantity);",
                    "        });",
                    "    }",
                    "    ",
                    "    pm.expect(cartData.totalPrice).to.eql(calculatedTotal);",
                    "});"
                  ],
